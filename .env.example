# Copy to .env on the server and fill in real values. Never commit the real .env.
# Local dev needs none of this — no .env means DEBUG=True + SQLite, same as before.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-output-of-generate_secret_key.py
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Leave DJANGO_SECURE_SSL_REDIRECT=0 until certbot/HTTPS is actually working end
# to end, then flip to 1 so plain-HTTP requests get redirected to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=1
# Raise to e.g. 31536000 (1 year) only after confirming HTTPS works — HSTS is
# a one-way door, browsers cache it and it's painful to undo.
DJANGO_HSTS_SECONDS=0

# DB_ENGINE defaults to postgres automatically once DJANGO_DEBUG=0 — listed
# here explicitly just for clarity. DB_NAME/USER/PASSWORD are still required;
# the app refuses to start in production without them (won't silently fall
# back to SQLite).
DB_ENGINE=postgres
DB_NAME=ternah
DB_USER=ternah
DB_PASSWORD=replace-with-a-real-password
DB_HOST=127.0.0.1
DB_PORT=5432
