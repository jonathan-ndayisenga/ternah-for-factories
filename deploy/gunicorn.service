# /etc/systemd/system/ternah-gunicorn.service
#
# 1GB droplet, 1 vCPU: 2 workers is the right number (the (2*cpu)+1 rule of
# thumb is for CPU-bound apps on multi-core boxes; here RAM is the binding
# constraint — each worker is a separate Python process with its own copy of
# Django loaded, easily 80-150MB each once psycopg + models are imported).
# --max-requests recycles workers periodically as a guard against slow memory
# creep over days of uptime, which matters much more on 1GB than it would
# on a bigger box.

[Unit]
Description=Ternah for Factories — gunicorn
After=network.target postgresql.service

[Service]
Type=notify
User=ternah
Group=ternah
WorkingDirectory=/home/ternah/ternah_factories
EnvironmentFile=/home/ternah/ternah_factories/.env
RuntimeDirectory=ternah
ExecStart=/home/ternah/ternah_factories/venv/bin/gunicorn \
    config.wsgi:application \
    --workers 2 \
    --threads 2 \
    --max-requests 500 \
    --max-requests-jitter 50 \
    --timeout 30 \
    --bind unix:/run/ternah/gunicorn.sock
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
